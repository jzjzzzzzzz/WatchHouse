[Unit]
Description=Watchhouse mutually authenticated event control API
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
DynamicUser=yes
EnvironmentFile=/etc/watchhouse/control.env
LoadCredential=database-url:/etc/watchhouse/control/database-url
LoadCredential=roles.json:/etc/watchhouse/control/roles.json
LoadCredential=client-ca.pem:/etc/watchhouse/control/client-ca.pem
LoadCredential=server-cert.pem:/etc/watchhouse/control/server-cert.pem
LoadCredential=server-key.pem:/etc/watchhouse/control/server-key.pem
ExecStart=/usr/local/libexec/watchhouse-control --listen ${WATCHHOUSE_LISTEN} --database-url-file ${CREDENTIALS_DIRECTORY}/database-url --roles-file ${CREDENTIALS_DIRECTORY}/roles.json --client-ca ${CREDENTIALS_DIRECTORY}/client-ca.pem --tls-cert ${CREDENTIALS_DIRECTORY}/server-cert.pem --tls-key ${CREDENTIALS_DIRECTORY}/server-key.pem --server-name ${WATCHHOUSE_SERVER_NAME}
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
LockPersonality=yes
MemoryMax=256M
TasksMax=64
TimeoutStartSec=20s
TimeoutStopSec=15s
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=watchhouse-control

[Install]
WantedBy=multi-user.target
